<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

        <BorderPane
                fx:id="mainLayout"
                xmlns="http://javafx.com/javafx/21"
                xmlns:fx="http://javafx.com/fxml/1"
                fx:controller="com.school.enrollment.ui.MainController"
                styleClass="root">

    <left>
        <VBox prefWidth="240"
              spacing="8"
              styleClass="sidebar">

            <Label text="SCHOOL ENROLLMENT"
                   styleClass="brand-title"/>

            <Label text="MANAGEMENT SYSTEM"
                   styleClass="brand-subtitle"/>

            <VBox spacing="5"
                  VBox.vgrow="ALWAYS"
                  styleClass="navigation">

                <Button text="Dashboard"
                        onAction="#showDashboard"
                        styleClass="nav-button"/>

                <Button text="Students"
                        onAction="#showStudents"
                        styleClass="nav-button"/>

                <Button text="Enrollment"
                        onAction="#showEnrollment"
                        styleClass="nav-button"/>

                <Button text="Subjects"
                        onAction="#showSubjects"
                        styleClass="nav-button"/>

                <Button text="Curriculum"
                        onAction="#showCurriculum"
                        styleClass="nav-button"/>

                <Button text="Teachers"
                        onAction="#showTeachers"
                        styleClass="nav-button"/>

                <Button text="Rooms"
                        onAction="#showRooms"
                        styleClass="nav-button"/>

                <Button text="Reports"
                        onAction="#showReports"
                        styleClass="nav-button"/>

            </VBox>

        </VBox>
    </left>

    <center>
        <StackPane styleClass="content">

            <VBox spacing="12"
                  maxWidth="800"
                  maxHeight="600">

                <Label fx:id="pageTitle"
                       text="Welcome"
                       styleClass="page-title"/>

                <Label fx:id="pageDescription"
                       text="School Enrollment Management System"
                       wrapText="true"
                       styleClass="page-description"/>

                <VBox spacing="8"
                      styleClass="welcome-card">

                    <Label text="System Foundation"
                           styleClass="card-title"/>

                    <Label text="Stage 1 is establishing the professional desktop application foundation. The functional enrollment modules will be implemented in later stages."
                           wrapText="true"
                           styleClass="card-description"/>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>